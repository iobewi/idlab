{
  "version": "2.0.0",
  "type": "process",
  "command": "powershell.exe",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "problemMatcher": [],
  "tasks": [
    {
      "label": "IDLab : Rechargement complet",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/idlab.ps1",
        "-Action",
        "reload"
      ],
      "options": {
        "statusbar": {
          "label": "$(refresh) IDLab",
          "detail": "IDLab : reconstruire et recharger le serveur"
        }
      }
    },
    {
      "label": "IDLab : Préparer le conteneur",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/idlab.ps1",
        "-Action",
        "prepare"
      ],
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "IDLab : Démarrer le serveur HTTP",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/idlab.ps1",
        "-Action",
        "start"
      ],
      "options": {
        "statusbar": {
          "label": "$(play) IDLab",
          "detail": "IDLab : démarrer le serveur HTTP"
        }
      }
    },
    {
      "label": "IDLab : Arrêter le serveur HTTP",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/idlab.ps1",
        "-Action",
        "stop"
      ],
      "options": {
        "statusbar": {
          "label": "$(debug-stop) IDLab",
          "detail": "IDLab : arrêter le serveur HTTP"
        }
      }
    },
    {
      "label": "IDLab : Redémarrer le serveur HTTP",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/idlab.ps1",
        "-Action",
        "restart"
      ],
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "IDLab : État du serveur HTTP",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/idlab.ps1",
        "-Action",
        "status"
      ],
      "options": {
        "statusbar": {
          "label": "$(pulse) IDLab",
          "detail": "IDLab : consulter l’état du serveur HTTP"
        }
      }
    }
  ]
}
